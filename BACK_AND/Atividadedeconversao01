const readline = require("readline");

const rl = readline.createInterface({
    input : process.stdin,
    output : process.stdout,
});

rl.question("Digite o seu nome: ",(nome)=> {
  rl.question("Digite a quantidade de pontos da fase: ",(fase)=> {
      rl.question("Digite a quantidade de pontos de bônus: ",(bonus)=> {

        fase = Number(fase)
        bonus = Number(bonus)

        const somas = (fase+bonus)

          console.log("-----------------------RESULTADO---------------------------");
             console.log("Jogador " + nome); 
                 console.log("Pontuação final é " + somas);
 
            
            
});
});
});
