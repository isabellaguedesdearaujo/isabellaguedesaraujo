const readline = require("readline");

const rl = readline.createInterface({
    input : process.stdin,
    output : process.stdout,
});

rl.question("Dígite sua idade:",(idade)=>{

    idade = Number (idade)
    
    if(idade >= 16){
        console.log("Entrada permitida!");
    }else if (idade < 16){
        console.log("Entrada não permitida!");}
});
